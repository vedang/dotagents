{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vedang.me/dotagents/schemas/coverage.v1.json",
  "title": "Dotagents discovery coverage",
  "description": "Closed producer-only record of audited package surfaces and discovered candidates intentionally excluded from publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageSurfaces", "excluded"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "packageSurfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packageSurfaceInventory"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "entryKind": {
      "type": "string",
      "enum": ["extension", "skill", "prompt"]
    },
    "packageSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/entryKind"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "packageSurfaceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "reviewedRevision", "surfaces"],
      "properties": {
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewedRevision": {
          "$ref": "#/$defs/revision"
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/packageSurface"
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["extension", "skill", "prompt", "package"]
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "surfacePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
