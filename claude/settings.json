{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(jj st:*)",
      "Bash(jj log:*)",
      "Bash(jj diff:*)",
      "Bash(jj show:*)",
      "Bash(jj new:*)",
      "Bash(jj desc:*)",
      "Bash(jj split:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(make format:*)",
      "Bash(make check:*)",
      "Bash(make test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" heartbeat"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/simplify-auto.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" turn_end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" turn_start"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "adr@pi-adr": true,
    "autoresearch@pi-autoresearch": true,
    "caveman@caveman": true,
    "chrome-cdp@chrome-cdp-skill": true,
    "dafny-estimation@dafny-estimation": false,
    "humanizer@humanizer": false,
    "rote-onboard@rote-skills": true,
    "unravel-proposal-creator@unravel-proposal-creator": true,
    "visual-explainer@visual-explainer-marketplace": true,
    "watcher@pi-watcher": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "vedang/caveman"
      }
    },
    "chrome-cdp-skill": {
      "source": {
        "source": "github",
        "repo": "vedang/chrome-cdp-skill"
      }
    },
    "dafny-estimation": {
      "source": {
        "source": "github",
        "repo": "unravel-team/dafny-estimation"
      }
    },
    "humanizer": {
      "source": {
        "source": "github",
        "repo": "vedang/humanizer"
      }
    },
    "pi-adr": {
      "source": {
        "source": "github",
        "repo": "vedang/pi-adr"
      }
    },
    "pi-autoresearch": {
      "source": {
        "source": "github",
        "repo": "vedang/pi-autoresearch"
      }
    },
    "pi-watcher": {
      "source": {
        "source": "github",
        "repo": "vedang/pi-watcher"
      }
    },
    "rote-skills": {
      "source": {
        "source": "github",
        "repo": "vedang/rote-skills"
      }
    },
    "unravel-proposal-creator": {
      "source": {
        "source": "github",
        "repo": "unravel-team/unravel-proposal-creator"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "source": "github",
        "repo": "nicobailon/visual-explainer"
      }
    }
  },
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
