{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "adr@pi-adr": true,
    "autoresearch@pi-autoresearch": true,
    "caveman@caveman": true,
    "chrome-cdp@chrome-cdp-skill": true,
    "dafny-estimation@dafny-estimation": true,
    "humanizer@humanizer": true,
    "rote-onboard@rote-skills": true,
    "unravel-proposal-creator@unravel-proposal-creator": true,
    "visual-explainer@visual-explainer-marketplace": true,
    "watcher@pi-watcher": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "vedang/caveman",
        "source": "github"
      }
    },
    "chrome-cdp-skill": {
      "source": {
        "repo": "vedang/chrome-cdp-skill",
        "source": "github"
      }
    },
    "dafny-estimation": {
      "source": {
        "repo": "unravel-team/dafny-estimation",
        "source": "github"
      }
    },
    "humanizer": {
      "source": {
        "repo": "vedang/humanizer",
        "source": "github"
      }
    },
    "pi-adr": {
      "source": {
        "repo": "vedang/pi-adr",
        "source": "github"
      }
    },
    "pi-autoresearch": {
      "source": {
        "repo": "vedang/pi-autoresearch",
        "source": "github"
      }
    },
    "pi-watcher": {
      "source": {
        "repo": "vedang/pi-watcher",
        "source": "github"
      }
    },
    "rote-skills": {
      "source": {
        "repo": "vedang/rote-skills",
        "source": "github"
      }
    },
    "unravel-proposal-creator": {
      "source": {
        "repo": "unravel-team/unravel-proposal-creator",
        "source": "github"
      }
    },
    "visual-explainer-marketplace": {
      "source": {
        "repo": "nicobailon/visual-explainer",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" heartbeat",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" stop",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" start",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/notify.sh",
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/simplify-auto.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" turn_end",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"/Users/nejo/Library/Application Support/Wel/hooks/wel-cc-hook.sh\" turn_start",
            "type": "command"
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory",
  "permissions": {
    "allow": [
      "Bash(jj st:*)",
      "Bash(jj log:*)",
      "Bash(jj diff:*)",
      "Bash(jj show:*)",
      "Bash(jj new:*)",
      "Bash(jj desc:*)",
      "Bash(jj split:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(make format:*)",
      "Bash(make check:*)",
      "Bash(make test:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/secrets/**)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "auto"
}
